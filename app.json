{
  "name": "暗黑天堂MMORPG-Server",
  "description": "暗黑奇幻MMORPG多人連線伺服器（Node.js + Socket.IO）。零外部依賴即可運行，資料庫為選配。",
  "keywords": ["node", "socket.io", "mmorpg", "multiplayer"],
  "website": "https://example.com",
  "repository": "https://github.com/你的帳號/mmorpg-server",
  "logo": "",
  "success_url": "/",
  "env": {
    "BOT_COUNT": {
      "description": "伺服器端AI玩家數量（單機測試用，真人多了可設0）",
      "value": "20"
    },
    "MAX_PER_CHANNEL": {
      "description": "每張地圖每頻道人數上限",
      "value": "60"
    },
    "NODE_ENV": {
      "value": "production"
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "basic"
    }
  },
  "buildpacks": [
    { "url": "heroku/nodejs" }
  ]
}
